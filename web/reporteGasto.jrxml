	<queryString>
		<![CDATA[select A.IDREPGASCAB ,A.TOTAL, B.FECHA, TO_CHAR(B.TOTALIM, 'FM999G990D00') AS ALI,TO_CHAR(B.TOTMOVI,'FM999G990D00') AS MOVI, B.TRABREALIZADO, C.CLIENTE
from REPGASCAB A, REPGASDET B, CLIENTE C
where A.IDREPGASCAB = $P{idCab}
AND B.IDREPGASCAB = A.IDREPGASCAB
AND B.IDCLIENTE = C.IDCLIENTE
ORDER BY B.FECHA]]>
	</queryString>
	<field name="IDREPGASCAB" class="java.math.BigDecimal"/>
	<field name="TOTAL" class="java.lang.Double"/>
