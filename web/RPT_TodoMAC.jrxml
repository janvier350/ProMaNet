	<queryString>
		<![CDATA[Select a.idtododet, a.idtodocabtrab, a.detalle, a.fechahorainicio, a.fechahorafin, (CASE a.est_det_trab WHEN 'P' THEN 'PENDIENTE' WHEN 'A' THEN 'ATRASADO' ELSE 'TERMINADO'  END) AS ESTADO,
b.idusuario, c.nombre||' '||c.apellidos NOMBRES
from TODODETTRAB A, TODOASIGTAREA B, USUARIO C
WHERE A.idtododet = B.idtododettrab AND b.idusuario= c.idusuario AND a.estado='A' 
AND a.idtodocabtrab = $P{idCab}]]>
	</queryString>
