	<subDataset name="Ds_TablaUsuarios" uuid="e4f98324-27d0-476d-bcb7-ceb008c61c0f">
		<queryString language="SQL">
			<![CDATA[select a.idusuario, a.nombre | | a.apellidos, a.email,  b.compania,c.departamento, c.descripcion
from usuario a, compania b, adm_departamento c
where a.estado = 'a' 
and a.idcompania = b.idcompania 
and a.id_adm_departamento = c.id_departamento]]>
		</queryString>
		<field name="IDUSUARIO" class="java.math.BigDecimal"/>
		<field name="A.NOMBRE||A.APELLIDOS" class="java.lang.String"/>
		<field name="EMAIL" class="java.lang.String"/>
		<field name="COMPANIA" class="java.lang.String"/>
		<field name="DEPARTAMENTO" class="java.lang.String"/>
		<field name="DESCRIPCION" class="java.lang.String"/>
	</subDataset>
